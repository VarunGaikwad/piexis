{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VarunGaikwad/piexis/main/schemas/agent.schema.json",
  "title": "PieXis agent configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema used by editor validation."
    },
    "model": { "$ref": "#/$defs/model" },
    "small_model": { "$ref": "#/$defs/model" },
    "subagent_model": { "$ref": "#/$defs/model" },
    "delegate_exploration": {
      "type": "boolean",
      "description": "Allow read-only exploration to use small_model."
    },
    "auto_profile": {
      "type": "boolean",
      "description": "Automatically select a profile for clear requests."
    },
    "codeHealth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "analyzeChangedFiles": {
          "type": "boolean"
        },
        "reviewAtTaskCompletion": {
          "type": "boolean"
        },
        "enableComplexityChecks": {
          "type": "boolean"
        },
        "enableDuplicationChecks": {
          "type": "boolean"
        },
        "enableArchitectureChecks": {
          "type": "boolean"
        },
        "enableAiReview": {
          "type": "boolean"
        },
        "enableRuff": {
          "type": "boolean"
        },
        "requireValidation": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "observe",
            "safe",
            "autonomous"
          ]
        },
        "largeFileThresholdLines": {
          "type": "integer",
          "minimum": 50,
          "maximum": 20000
        },
        "maxFilesPerReview": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxAutomaticFixesPerTask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "maxReviewMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "maxAiOutputTokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "exclude": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "subagent_variant_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/variant" },
        "orchestrator": { "$ref": "#/$defs/variant" },
        "debug": { "$ref": "#/$defs/variant" },
        "ask": { "$ref": "#/$defs/variant" },
        "code": { "$ref": "#/$defs/variant" }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "string",
      "pattern": "^[^\\s/]+/\\S+$",
      "description": "Exact provider/model ID from /model."
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/model" },
        "effort": {
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
        }
      }
    }
  }
}
