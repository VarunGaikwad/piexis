{
  "name": "@preapexis/piexis",
  "version": "0.1.0",
  "type": "module",
  "description": "Extensions, skills, prompts, and themes for pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": { "node": ">=24" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "test:sandbox": "PIEXIS_REQUIRE_SANDBOX=1 node --test tests/mode-sandbox.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "jiti": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
