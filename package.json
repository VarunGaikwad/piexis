{
  "name": "@preapexis/piexis",
  "version": "0.2.3",
  "type": "module",
  "description": "Extensions, skills, prompts, and themes for pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/VarunGaikwad/piexis"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "release": "node scripts/release.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-question.ts",
      "./extensions/ui.ts",
      "./extensions/recommended-tools.ts",
      "./extensions/agents.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
