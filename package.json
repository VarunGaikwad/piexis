{
  "name": "@preapexis/piexis",
  "version": "0.2.11",
  "type": "module",
  "description": "Extensions, skills, prompts, and themes for pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/VarunGaikwad/piexis"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "bin": {
    "piexis-web": "./bin/piexis-web.mjs"
  },
  "files": [
    "apps/server/",
    "apps/web/dist/",
    "bin/",
    "extensions/",
    "lib/",
    "packages/",
    "prompts/",
    "schemas/",
    "skills/",
    "themes/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:webui": "node --import tsx --test tests/webui/*.test.ts",
    "check": "tsc --noEmit",
    "check:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "check:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "build": "vite build --config apps/web/vite.config.ts",
    "prepack": "npm run build",
    "dev": "node scripts/dev.mjs",
    "release": "node scripts/release.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-question.ts",
      "./extensions/ui.ts",
      "./extensions/recommended-tools.ts",
      "./extensions/access-guard.ts",
      "./extensions/agents.ts",
      "./extensions/webui.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
